{
  "name": "timetable-finder-backend",
  "version": "1.1.0",
  "description": "Read-only API for the BMSCE timetable graph (Neo4j) that also serves the frontend page",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1",
    "load-data": "node scripts/load-data.js",
    "export-snapshot": "node scripts/export-snapshot.js",
    "check-db": "node scripts/check-db.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "neo4j-driver": "^5.26.0"
  }
}
