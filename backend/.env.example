# Settings of the backend. The real file is backend/.env - it holds a password, so never share or commit it.

# Which Neo4j database to read, and its login.
#   The project's own database (folder local-neo4j):  bolt://127.0.0.1:17687
#   Neo4j Desktop:                                     neo4j://127.0.0.1:7687
#   Neo4j Aura:                                        neo4j+s://YOUR-ID.databases.neo4j.io
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Port of this server. The page is then at http://localhost:3100
PORT=3100

# Optional. HOST=0.0.0.0 lets other devices on your network open the page (it has no login of its own).
# HOST=127.0.0.1

# Optional. Only needed when the page is served from another address than this server.
# FRONTEND_URL=http://localhost:5173
